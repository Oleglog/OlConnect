<?xml version="1.0" encoding="utf-8"?>
<!-- A chip: a small context label, never a button. Colours come from the theme,
     so the chip follows whichever palette and accent the user picked. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
    <corners android:radius="@dimen/corner_button" />
</shape>
