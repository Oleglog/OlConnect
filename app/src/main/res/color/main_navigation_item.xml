<?xml version="1.0" encoding="utf-8"?>
<!-- Selected tab reads as primary ink, the rest as muted ink: both come from the
     theme, so every palette and accent keeps them legible. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="?attr/colorOnSurface" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
