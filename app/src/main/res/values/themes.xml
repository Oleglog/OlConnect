    <style name="ThemeOverlay.OlcrtcClient.Accent.Violet" parent="">
        <item name="colorPrimary">@color/appearance_accent_violet</item>
        <item name="colorOnPrimary">@color/appearance_accent_violet_on</item>
        <item name="colorPrimaryContainer">@color/appearance_accent_violet_container</item>
        <item name="colorOnPrimaryContainer">@color/appearance_accent_violet_on_container</item>
