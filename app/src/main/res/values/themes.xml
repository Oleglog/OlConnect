        <item name="colorPrimary">@color/olcrtc_mono_primary</item>
        <item name="colorOnPrimary">@color/olcrtc_mono_on_primary</item>
        <item name="colorPrimaryContainer">@color/olcrtc_mono_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/olcrtc_mono_on_primary_container</item>
        <item name="colorSecondary">@color/olcrtc_mono_secondary</item>
        <item name="colorOnSecondary">@color/olcrtc_mono_on_secondary</item>
        <item name="colorSurface">@color/olcrtc_mono_surface</item>
        <item name="colorSurfaceContainer">@color/olcrtc_mono_surface_container</item>
