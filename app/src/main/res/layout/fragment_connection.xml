<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/connection_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="@dimen/space_5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding">

            <!-- .app-top: screen name + a chip with the profile in use. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_height"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_2"
                android:paddingBottom="@dimen/space_2">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_olc"
                    android:textAppearance="@style/TextAppearance.Olcrtc.Wordmark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_rtc"
                    android:textAppearance="@style/TextAppearance.Olcrtc.Wordmark"
                    android:textColor="?attr/colorPrimary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/connection_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:background="@drawable/bg_chip"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:maxWidth="180dp"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.Olcrtc.Service"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- loading / empty / error: the same block as before, recoloured. -->
            <LinearLayout
                android:id="@+id/content_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_7"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/content_loading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminate="true"
                    app:indicatorSize="32dp"
                    app:trackThickness="3dp" />

                <TextView
                    android:id="@+id/content_state_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center"
                    android:text="@string/connection_loading_title"
                    android:textAppearance="@style/TextAppearance.Olcrtc.TitleLarge" />

                <TextView
                    android:id="@+id/content_state_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="center"
                    android:text="@string/connection_loading_message"
                    android:textAppearance="@style/TextAppearance.Olcrtc.Body"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/content_state_action"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_primary_height"
                    android:layout_marginTop="@dimen/space_4"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="160dp"
                    android:text="@string/add_connection"
                    android:textAppearance="@style/TextAppearance.Olcrtc.LabelStrong"
                    android:visibility="gone"
                    app:cornerRadius="@dimen/corner_button"
                    app:icon="@drawable/ic_add_24"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- .tile: state word + uptime, the rate, the rail, two numbers. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <io.github.oleglog.olcrtc.client.ui.ConnectionGlowView
                        android:id="@+id/connection_halo"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_gravity="center_vertical" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="@dimen/corner_card"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="@dimen/card_border">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/tile_padding">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:id="@+id/connection_status_dot"
                                    android:layout_width="@dimen/state_rule_width"
                                    android:layout_height="@dimen/state_rule_height"
                                    android:background="@drawable/bg_state_rule"
                                    android:importantForAccessibility="no" />

                                <TextView
                                    android:id="@+id/connection_summary"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_1"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/vpn_state_stopped"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.State" />

                                <TextView
                                    android:id="@+id/connection_timer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_2"
                                    android:text="@string/connection_timer_zero"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:baselineAligned="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/connection_rate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/traffic_zero_rate"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.NumBig"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/connection_rate_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_1"
                                    android:text="@string/connection_rate_unit"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.Service"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <io.github.oleglog.olcrtc.client.ui.SessionRailView
                                android:id="@+id/session_rail"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/rail_height"
                                android:layout_marginTop="@dimen/space_2"
                                android:importantForAccessibility="no" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/rail_label_start"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/rail_window_ago"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.Service"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/rail_label_end"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/rail_window_now"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.Service"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/connection_stage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearance.Olcrtc.Service"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/connection_received"
                                        android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:id="@+id/connection_received"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/traffic_zero"
                                        android:textAppearance="@style/TextAppearance.Olcrtc.Num" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/connection_latency"
                                        android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:id="@+id/connection_latency"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/connection_latency_empty"
                                        android:textAppearance="@style/TextAppearance.Olcrtc.Num" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <!-- The one action on the screen: 44 px, primary unless connected. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connect"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_primary_height"
                    android:layout_marginTop="@dimen/tile_gap"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/connect"
                    android:textAppearance="@style/TextAppearance.Olcrtc.LabelStrong"
                    app:cornerRadius="@dimen/corner_button"
                    app:icon="@drawable/ic_power_24"
                    app:iconGravity="textStart" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="@drawable/bg_status_message"
                    android:padding="@dimen/space_3"
                    android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <!-- .tile: profile and carrier. No route row: the client does not
                     know the exit address, and an empty row is better than a guess. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tile_gap"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/corner_card"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/card_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/tile_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="28dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/connection_info_profile"
                                android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/info_profile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/connection_info_empty"
                                android:textAppearance="@style/TextAppearance.Olcrtc.TitleSmall" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="28dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/connection_info_carrier"
                                android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/info_carrier"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/connection_info_empty"
                                android:textAppearance="@style/TextAppearance.Olcrtc.TitleSmall" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Connections: one row per profile, the active one marked by a rule. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/connection_profiles"
                        android:textAppearance="@style/TextAppearance.Olcrtc.TitleMedium" />

                    <FrameLayout
                        android:layout_width="@dimen/icon_touch_target"
                        android:layout_height="@dimen/icon_touch_target">

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/test_all_profiles"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/profile_test_all"
                            android:padding="@dimen/space_3"
                            android:src="@drawable/ic_ping_24"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/all_profiles_progress"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/profile_latency_checking"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorSize="22dp"
                            app:trackThickness="2dp" />
                    </FrameLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/profile_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/test_selected_container"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_secondary_height"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/test_selected"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:text="@string/profile_ping_vpn"
                            android:textAppearance="@style/TextAppearance.Olcrtc.NumSmall"
                            app:cornerRadius="@dimen/corner_button"
                            app:icon="@drawable/ic_ping_24"
                            app:iconGravity="textStart" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/ping_progress"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorSize="22dp"
                            app:trackThickness="2dp" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_profile"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_secondary_height"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="@string/add_connection"
                        android:textAppearance="@style/TextAppearance.Olcrtc.LabelStrong"
                        app:cornerRadius="@dimen/corner_button"
                        app:icon="@drawable/ic_add_24"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- Today's counters stay, secondary to the live rate. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tile_gap"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/corner_card"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/card_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/tile_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/connection_today"
                            android:textAppearance="@style/TextAppearance.Olcrtc.TitleSmall" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/today_download"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/traffic_zero_rate"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.Num" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="@string/connection_download"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.Service"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/today_upload"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/traffic_zero_rate"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.Num" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="@string/connection_upload"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.Service"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/today_total"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/traffic_zero"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.Num" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="@string/connection_total_today"
                                    android:textAppearance="@style/TextAppearance.Olcrtc.Service"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
