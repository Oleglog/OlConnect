<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, per client-settings.html: groups of 48 px rows, label on the left
     and the value in mono on the right. Behaviour lives in the fragment; the two
     tunnel switches moved here from the VPN screen and keep their ids. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/space_5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/page_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/navigation_settings"
            android:textAppearance="@style/TextAppearance.Olcrtc.TitleLarge" />

        <!-- Оформление: палитра, акценты и системные эффекты. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/settings_group_interface"
            android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="@dimen/card_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/settings_appearance_row"
                    style="@style/Widget.OlcrtcClient.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_appearance_title"
                        android:textAppearance="@style/TextAppearance.Olcrtc.TitleMedium" />

                    <TextView
                        android:id="@+id/settings_appearance_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Olcrtc.NumSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="@dimen/icon_action_size"
                        android:layout_height="@dimen/icon_action_size"
                        android:layout_marginStart="@dimen/space_1"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.OlcrtcClient.SettingsDivider" />

                <LinearLayout
                    android:id="@+id/settings_system_row"
                    style="@style/Widget.OlcrtcClient.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_system_title"
                        android:textAppearance="@style/TextAppearance.Olcrtc.TitleMedium" />

                    <TextView
                        android:id="@+id/settings_system_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Olcrtc.NumSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="@dimen/icon_action_size"
                        android:layout_height="@dimen/icon_action_size"
                        android:layout_marginStart="@dimen/space_1"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Туннель: маршрут, приложения, DNS и два переключателя. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/settings_group_connection"
            android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="@dimen/card_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/settings_routing_row"
                    style="@style/Widget.OlcrtcClient.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_routing_title"
                        android:textAppearance="@style/TextAppearance.Olcrtc.TitleMedium" />

                    <TextView
                        android:id="@+id/settings_routing_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Olcrtc.NumSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="@dimen/icon_action_size"
                        android:layout_height="@dimen/icon_action_size"
                        android:layout_marginStart="@dimen/space_1"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.OlcrtcClient.SettingsDivider" />

                <LinearLayout
                    android:id="@+id/settings_apps_row"
                    style="@style/Widget.OlcrtcClient.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_per_app_title"
                        android:textAppearance="@style/TextAppearance.Olcrtc.TitleMedium" />

                    <TextView
                        android:id="@+id/settings_apps_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Olcrtc.NumSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="@dimen/icon_action_size"
                        android:layout_height="@dimen/icon_action_size"
                        android:layout_marginStart="@dimen/space_1"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.OlcrtcClient.SettingsDivider" />

                <LinearLayout
                    android:id="@+id/settings_dns_row"
                    style="@style/Widget.OlcrtcClient.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/dns_server"
                        android:textAppearance="@style/TextAppearance.Olcrtc.TitleMedium" />

                    <TextView
                        android:id="@+id/settings_dns_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Olcrtc.NumSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="@dimen/icon_action_size"
                        android:layout_height="@dimen/icon_action_size"
                        android:layout_marginStart="@dimen/space_1"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.OlcrtcClient.SettingsDivider" />

                <LinearLayout
                    style="@style/Widget.OlcrtcClient.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/failover_auto_title"
                            android:textAppearance="@style/TextAppearance.Olcrtc.TitleMedium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/failover_auto_subtitle"
                            android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/auto_failover"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Widget.OlcrtcClient.SettingsDivider" />

                <LinearLayout
                    style="@style/Widget.OlcrtcClient.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/udp_relay_title"
                            android:textAppearance="@style/TextAppearance.Olcrtc.TitleMedium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/udp_relay_subtitle"
                            android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/udp_relay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Служебное: обновления, диагностика, о приложении. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/settings_group_support"
            android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="@dimen/card_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/settings_updates_row"
                    style="@style/Widget.OlcrtcClient.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_updates_title"
                        android:textAppearance="@style/TextAppearance.Olcrtc.TitleMedium" />

                    <TextView
                        android:id="@+id/settings_updates_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Olcrtc.NumSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="@dimen/icon_action_size"
                        android:layout_height="@dimen/icon_action_size"
                        android:layout_marginStart="@dimen/space_1"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.OlcrtcClient.SettingsDivider" />

                <LinearLayout
                    android:id="@+id/settings_diagnostics_row"
                    style="@style/Widget.OlcrtcClient.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_diagnostics_title"
                        android:textAppearance="@style/TextAppearance.Olcrtc.TitleMedium" />

                    <TextView
                        android:id="@+id/settings_diagnostics_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Olcrtc.NumSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="@dimen/icon_action_size"
                        android:layout_height="@dimen/icon_action_size"
                        android:layout_marginStart="@dimen/space_1"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.OlcrtcClient.SettingsDivider" />

                <LinearLayout
                    android:id="@+id/settings_about_row"
                    style="@style/Widget.OlcrtcClient.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_about"
                        android:textAppearance="@style/TextAppearance.Olcrtc.TitleMedium" />

                    <TextView
                        android:id="@+id/settings_about_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Olcrtc.NumSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="@dimen/icon_action_size"
                        android:layout_height="@dimen/icon_action_size"
                        android:layout_marginStart="@dimen/space_1"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
