<?xml version="1.0" encoding="utf-8"?>
<!-- Subscriptions, per client-profiles.html: one panel of saved sources, then the
     single primary action with its hint. Rows are built in code (the source list
     is dynamic), the panel keeps the ids the fragment already drives. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/space_5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/page_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/navigation_profiles"
            android:textAppearance="@style/TextAppearance.Olcrtc.TitleLarge" />

        <LinearLayout
            android:id="@+id/subscription_status_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/subscription_progress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorSize="18dp"
                app:trackThickness="2dp" />

            <TextView
                android:id="@+id/subscription_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tile_gap"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="@dimen/card_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/tile_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profiles_saved_title"
                    android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/corner_button"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/card_border">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="@dimen/space_5"
                        android:text="@string/subscriptions_placeholder"
                        android:textAppearance="@style/TextAppearance.Olcrtc.Caption"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/profile_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_subscription"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_primary_height"
            android:layout_marginTop="@dimen/tile_gap"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/add_connection"
            android:textAppearance="@style/TextAppearance.Olcrtc.LabelStrong"
            app:cornerRadius="@dimen/corner_button"
            app:icon="@drawable/ic_add_24"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/paste_subscription"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_secondary_height"
            android:layout_marginTop="@dimen/space_2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/paste_clipboard"
            android:textAppearance="@style/TextAppearance.Olcrtc.LabelStrong"
            app:cornerRadius="@dimen/corner_button"
            app:icon="@drawable/ic_paste_24"
            app:iconGravity="textStart" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:text="@string/profiles_add_hint"
            android:textAppearance="@style/TextAppearance.Olcrtc.Service"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
